{
  "rules": {
    "mate": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('host').val() == auth.uid || auth.token.firebase.sign_in_provider != 'anonymous')",
        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid == $uid || auth.token.firebase.sign_in_provider != 'anonymous')"
          }
        },
        "answers": {
          "$uid": {
            ".write": "auth != null && (auth.uid == $uid || auth.token.firebase.sign_in_provider != 'anonymous')"
          }
        }
      }
    },
    "games": {
      "$roomId": {
        ".read": "auth != null && data.child('players').child(auth.uid).exists()",
        ".write": "auth != null && (!data.exists() || data.child('players').child(auth.uid).exists() || newData.child('players').child(auth.uid).exists())"
      }
    }
  }
}
